rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function sessionPath(sessionId) {
      return /databases/$(database)/documents/sessions/$(sessionId);
    }

    function hasRole(sessionId, role) {
      return request.auth != null
        && request.auth.token.sessionId == sessionId
        && request.auth.token.role == role;
    }

    function sessionIsActive(sessionId) {
      return exists(sessionPath(sessionId))
        && get(sessionPath(sessionId)).data.status == 'active'
        && get(sessionPath(sessionId)).data.expiresAt is timestamp
        && get(sessionPath(sessionId)).data.expiresAt > request.time;
    }

    function isHost(sessionId) {
      return hasRole(sessionId, 'host') && sessionIsActive(sessionId);
    }

    function isMobile(sessionId) {
      return hasRole(sessionId, 'mobile') && sessionIsActive(sessionId);
    }

    match /sessions/{sessionId} {
      allow get: if isHost(sessionId) || isMobile(sessionId);
      allow list, create, delete: if false;
      allow update: if isHost(sessionId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'hostConnected',
          'connectedAt',
          'mobileConnected',
          'agentCount',
          'lastSyncedAt',
          'lastHeartbeatAt'
        ])
        && request.resource.data.status in ['active', 'closed'];

      match /state/{docId} {
        allow read: if isHost(sessionId) || isMobile(sessionId);
        allow create, update, delete: if isHost(sessionId);
      }

      match /inbox/{docId} {
        allow create: if isMobile(sessionId)
          && request.resource.data.keys().hasOnly(['type', 'payload', 'timestamp', 'processed'])
          && request.resource.data.type in ['handshake', 'prompt']
          && request.resource.data.payload is map
          && request.resource.data.timestamp is string
          && request.resource.data.processed == false;
        allow read: if isHost(sessionId);
        allow update: if isHost(sessionId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['processed'])
          && request.resource.data.processed == true;
        allow delete: if false;
      }

      match /outbox/{docId} {
        allow read: if isHost(sessionId) || isMobile(sessionId);
        allow create, update, delete: if isHost(sessionId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
